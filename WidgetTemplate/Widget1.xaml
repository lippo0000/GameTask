<Page
    x:Class="WidgetTemplate.Widget1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WidgetTemplate"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    Background="#1A1A1A"
    Width="320">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:LaunchedToOpacityConverter x:Key="LaunchedToOpacityConverter"/>
        <local:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibility"/>
        <local:RunningToPlayForegroundConverter x:Key="RunningToPlayForegroundConverter"/>

        <DataTemplate x:Key="EmojiItemTemplate">
            <TextBlock Text="{Binding}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>

        <Style x:Key="EmojiGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Per-color hover button styles -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#22FFFFFF"/>
                                            <Setter Target="Content.Foreground" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#22FFFFFF"/>
                                            <Setter Target="Content.Foreground" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#18FFFFFF"/>
                                            <Setter Target="Content.Foreground" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Add to list button -->
        <Style x:Key="AddBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A3D1F"/>
            <Setter Property="BorderBrush" Value="#2E6B35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#7AAF7E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0,0"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter x:Name="Content" Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#4CAF50"/>
                                            <Setter Target="Root.BorderBrush" Value="#4CAF50"/>
                                            <Setter Target="Content.Foreground" Value="White"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#4CAF50"/>
                                            <Setter Target="Root.BorderBrush" Value="#4CAF50"/>
                                            <Setter Target="Content.Foreground" Value="White"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#388E3C"/>
                                            <Setter Target="Root.BorderBrush" Value="#388E3C"/>
                                            <Setter Target="Content.Foreground" Value="White"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger (red) button — used for helper error panel -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#5C1A1A"/>
            <Setter Property="BorderBrush" Value="#8B2020"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FF8A80"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter x:Name="Content" Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#F44336"/>
                                            <Setter Target="Root.BorderBrush" Value="#F44336"/>
                                            <Setter Target="Content.Foreground" Value="White"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#F44336"/>
                                            <Setter Target="Root.BorderBrush" Value="#F44336"/>
                                            <Setter Target="Content.Foreground" Value="White"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#C62828"/>
                                            <Setter Target="Root.BorderBrush" Value="#C62828"/>
                                            <Setter Target="Content.Foreground" Value="White"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox style: fixed height, no grow on hover -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0FFFFFF"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="SelectionHighlightColor">
                <Setter.Value>
                    <SolidColorBrush Color="#804FC3FF"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Height="34">
                            <Border x:Name="BackgroundElement" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <ScrollViewer x:Name="ContentElement"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollMode="Auto" VerticalScrollMode="Disabled"/>
                            <TextBlock x:Name="PlaceholderTextContentPresenter"
                                       Margin="{TemplateBinding Padding}"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="#66FFFFFF" FontSize="{TemplateBinding FontSize}"
                                       IsHitTestVisible="False" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundElement.Background" Value="#4A4A5A"/>
                                            <Setter Target="BackgroundElement.BorderBrush" Value="#884FC3FF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundElement.Background" Value="#2A2A2A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox with leading FontIcon + ValidationStates (Valid / Error) -->
        <Style x:Key="DarkTextBoxWithIcon" TargetType="TextBox">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0FFFFFF"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="SelectionHighlightColor">
                <Setter.Value>
                    <SolidColorBrush Color="#804FC3FF"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Height="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Background spans both columns -->
                            <Border x:Name="BackgroundElement"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <!-- Permanent icon in left column — always visible, never collapses -->
                            <FontIcon x:Name="PlaceholderIcon"
                                      Grid.Column="0"
                                      Glyph="{TemplateBinding Tag}"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="11"
                                      Foreground="#66FFFFFF"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            <!-- Text input in right column -->
                            <ScrollViewer x:Name="ContentElement"
                                          Grid.Column="1"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          HorizontalScrollMode="Auto" VerticalScrollMode="Disabled"/>
                            <!-- Placeholder text only — framework auto-collapses when user types -->
                            <TextBlock x:Name="PlaceholderTextContentPresenter"
                                       Grid.Column="1"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="#66FFFFFF"
                                       FontSize="{TemplateBinding FontSize}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundElement.Background" Value="#4A4A5A"/>
                                            <Setter Target="BackgroundElement.BorderBrush" Value="#884FC3FF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundElement.Background" Value="#2A2A2A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="ValidationStates">
                                    <VisualState x:Name="Valid"/>
                                    <VisualState x:Name="Error">
                                        <VisualState.Setters>
                                            <Setter Target="PlaceholderIcon.Foreground" Value="#F44336"/>
                                            <Setter Target="PlaceholderTextContentPresenter.Foreground" Value="#F44336"/>
                                            <Setter Target="BackgroundElement.BorderBrush" Value="#884F0A0A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0FFFFFF"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{TemplateBinding Foreground}"/>
                                    <FontIcon Grid.Column="1" Glyph="&#xE70D;"
                                              FontFamily="Segoe Fluent Icons" FontSize="10"
                                              Foreground="#88FFFFFF" Margin="6,0,2,0"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border x:Name="PopupBorder"
                                        Background="#2C2C2C"
                                        BorderBrush="#44FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#44444A"/>
                                            <Setter Target="Root.BorderBrush" Value="#66FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="#884FC3FF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#404048"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#2A2A2A"/>
                                            <Setter Target="Root.BorderBrush" Value="#22FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox with leading FontIcon placeholder (icon from Tag, text from PlaceholderText).
             ContentStates (NoContent / HasContent) driven by the framework. -->
        <Style x:Key="DarkComboBoxWithIcon" TargetType="ComboBox">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0FFFFFF"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Selected item — hidden until framework fires HasContent -->
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Grid.Column="0"
                                                      Visibility="Collapsed"
                                                      VerticalAlignment="Center"
                                                      Foreground="{TemplateBinding Foreground}"/>
                                    <!-- Placeholder shown when no item is selected -->
                                    <StackPanel x:Name="PlaceholderPanel"
                                                Grid.Column="0"
                                                Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <FontIcon Glyph="{TemplateBinding Tag}"
                                                  FontFamily="Segoe Fluent Icons"
                                                  FontSize="11"
                                                  Foreground="#66FFFFFF"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="{TemplateBinding PlaceholderText}"
                                                   Foreground="#66FFFFFF"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" Glyph="&#xE70D;"
                                              FontFamily="Segoe Fluent Icons" FontSize="10"
                                              Foreground="#88FFFFFF" Margin="6,0,2,0"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border x:Name="PopupBorder"
                                        Background="#2C2C2C"
                                        BorderBrush="#44FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#44444A"/>
                                            <Setter Target="Root.BorderBrush" Value="#66FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="#884FC3FF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#404048"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#2A2A2A"/>
                                            <Setter Target="Root.BorderBrush" Value="#22FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="ContentStates">
                                    <VisualState x:Name="NoContent"/>
                                    <VisualState x:Name="HasContent">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Visibility" Value="Visible"/>
                                            <Setter Target="PlaceholderPanel.Visibility" Value="Collapsed"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Multi-line TextBox — auto-height, wrapping, no fixed row count -->
        <Style x:Key="DarkTextBoxMultiLine" TargetType="TextBox">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0FFFFFF"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="SelectionHighlightColor">
                <Setter.Value>
                    <SolidColorBrush Color="#804FC3FF"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="BackgroundElement" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <ScrollViewer x:Name="ContentElement"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollMode="Auto" HorizontalScrollMode="Disabled"
                                          VerticalScrollBarVisibility="Auto"/>
                            <TextBlock x:Name="PlaceholderTextContentPresenter"
                                       Margin="{TemplateBinding Padding}"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="#66FFFFFF" FontSize="{TemplateBinding FontSize}"
                                       IsHitTestVisible="False" VerticalAlignment="Top"
                                       TextWrapping="Wrap"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundElement.Background" Value="#4A4A5A"/>
                                            <Setter Target="BackgroundElement.BorderBrush" Value="#884FC3FF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundElement.Background" Value="#2A2A2A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- W11: rounded MenuFlyout presenter — dark themed -->
        <Style x:Key="RoundedMenuFlyoutPresenter" TargetType="MenuFlyoutPresenter">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MAIN SCROLL AREA -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#25282C">
            <StackPanel>

                <!-- EMOJI PICKER -->
                <Border x:Name="EmojiSection" Visibility="Collapsed"
                        Background="#1E1E1E" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="12,12,12,10" CornerRadius="8">
                    <StackPanel Spacing="0">

                        <!-- ── Header ── -->
                        <StackPanel Spacing="3" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xED53;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                                <TextBlock Text="Select Emoji" FontSize="14" FontWeight="SemiBold"
                                           Foreground="White" FontFamily="Segoe UI Variable Display"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Insert a character from the emoji board, or pick one from the grids below."
                                       FontSize="10" Foreground="#66FFFFFF" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- ── Section 1: Insert from emoji board ── -->
                        <Border Background="#252525" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="INSERT FROM EMOJI BOARD" FontSize="9" Foreground="#55FFFFFF"
                                               FontWeight="SemiBold" CharacterSpacing="80"/>
                                    <TextBlock Text="Open the Windows emoji board, pick one, then confirm with OK."
                                               FontSize="10" Foreground="#55FFFFFF" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CustomEmojiBox" Grid.Column="0"
                                             PlaceholderText="Emoji goes here…"
                                             MaxLength="2"
                                             Style="{StaticResource DarkTextBox}" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Click="EmojiMenu_Click"
                                            Style="{StaticResource IconBtn}"
                                            Foreground="#99FFFFFF" Tag="#99FFFFFF"
                                            ToolTipService.ToolTip="Open Windows emoji board (Win + .)"
                                            Height="34" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="8,0">
                                            <FontIcon Glyph="&#xED53;" FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Open emoji board" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Content="OK" Click="CustomEmoji_Click"
                                            Height="34" Width="48" FontSize="12" FontWeight="SemiBold"
                                            Background="#2E7D32" BorderBrush="#4CAF50" BorderThickness="1"
                                            Foreground="White">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Root" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Foreground="{TemplateBinding Foreground}"
                                                                      FontSize="{TemplateBinding FontSize}"
                                                                      FontWeight="{TemplateBinding FontWeight}"/>
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal"/>
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Target="Root.Background" Value="#4CAF50"/>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <VisualState.Setters>
                                                                    <Setter Target="Root.Background" Value="#1B5E20"/>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Disabled"/>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Section 2: Pick from grids ── -->
                        <Border Background="#252525" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                                <StackPanel Spacing="2" Margin="0,0,0,4">
                                    <TextBlock Text="PICK FROM GRID" FontSize="9" Foreground="#55FFFFFF"
                                               FontWeight="SemiBold" CharacterSpacing="80"/>
                                    <TextBlock Text="Tap any emoji below to apply it instantly."
                                               FontSize="10" Foreground="#55FFFFFF"/>
                                </StackPanel>

                                <!-- Games -->
                                <TextBlock Text="Games" FontSize="10" Foreground="#66FFFFFF" FontWeight="SemiBold" CharacterSpacing="60" Margin="0,4,0,0"/>
                                <GridView x:Name="EmojiGridGames" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="EmojiGrid_ItemClick" Background="Transparent"
                                          IsTabStop="True" TabNavigation="Cycle"
                                          XYFocusKeyboardNavigation="Enabled"
                                          XYFocusDownNavigationStrategy="Projection" XYFocusRightNavigationStrategy="Projection">
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="Padding" Value="2"/>
                                            <Setter Property="Margin" Value="2"/>
                                            <Setter Property="Width" Value="40"/>
                                            <Setter Property="Height" Value="40"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <!-- Apps -->
                                <TextBlock Text="Apps" FontSize="10" Foreground="#66FFFFFF" FontWeight="SemiBold" CharacterSpacing="60" Margin="0,4,0,0"/>
                                <GridView x:Name="EmojiGridApps" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="EmojiGrid_ItemClick" Background="Transparent"
                                          IsTabStop="True" TabNavigation="Cycle"
                                          XYFocusKeyboardNavigation="Enabled"
                                          XYFocusDownNavigationStrategy="Projection" XYFocusRightNavigationStrategy="Projection">
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="Padding" Value="2"/>
                                            <Setter Property="Margin" Value="2"/>
                                            <Setter Property="Width" Value="40"/>
                                            <Setter Property="Height" Value="40"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <!-- Tools -->
                                <TextBlock Text="Tools" FontSize="10" Foreground="#66FFFFFF" FontWeight="SemiBold" CharacterSpacing="60" Margin="0,4,0,0"/>
                                <GridView x:Name="EmojiGridTools" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="EmojiGrid_ItemClick" Background="Transparent"
                                          IsTabStop="True" TabNavigation="Cycle"
                                          XYFocusKeyboardNavigation="Enabled"
                                          XYFocusDownNavigationStrategy="Projection" XYFocusRightNavigationStrategy="Projection">
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="Padding" Value="2"/>
                                            <Setter Property="Margin" Value="2"/>
                                            <Setter Property="Width" Value="40"/>
                                            <Setter Property="Height" Value="40"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <!-- Media / Comms -->
                                <TextBlock Text="Media / Comms" FontSize="10" Foreground="#66FFFFFF" FontWeight="SemiBold" CharacterSpacing="60" Margin="0,4,0,0"/>
                                <GridView x:Name="EmojiGridMedia" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="EmojiGrid_ItemClick" Background="Transparent"
                                          IsTabStop="True" TabNavigation="Cycle"
                                          XYFocusKeyboardNavigation="Enabled"
                                          XYFocusDownNavigationStrategy="Projection" XYFocusRightNavigationStrategy="Projection">
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="Padding" Value="2"/>
                                            <Setter Property="Margin" Value="2"/>
                                            <Setter Property="Width" Value="40"/>
                                            <Setter Property="Height" Value="40"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <!-- Misc -->
                                <TextBlock Text="Misc" FontSize="10" Foreground="#66FFFFFF" FontWeight="SemiBold" CharacterSpacing="60" Margin="0,4,0,0"/>
                                <GridView x:Name="EmojiGridMisc" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="EmojiGrid_ItemClick" Background="Transparent"
                                          IsTabStop="True" TabNavigation="Cycle"
                                          XYFocusKeyboardNavigation="Enabled"
                                          XYFocusDownNavigationStrategy="Projection" XYFocusRightNavigationStrategy="Projection">
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="Padding" Value="2"/>
                                            <Setter Property="Margin" Value="2"/>
                                            <Setter Property="Width" Value="40"/>
                                            <Setter Property="Height" Value="40"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </StackPanel>
                        </Border>

                        <!-- ── Cancel ── -->
                        <Button Content="Cancel" Click="EmojiCancel_Click"
                                HorizontalAlignment="Right"
                                Style="{StaticResource IconBtn}"
                                Foreground="#66FFFFFF" Tag="#66FFFFFF"
                                IsTabStop="False"
                                FontSize="11" Width="60" Height="28"/>
                    </StackPanel>
                </Border>

                <!-- PROCESS LIST (grouped by category) -->
                <ItemsControl x:Name="CategoryList" Padding="0,12" Background="#1A1A1A" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:CategoryGroup">
                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{x:Bind IsVisibleAndHasEntries, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <!-- Category Header -->
                                <Grid Margin="16,2,16,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Icon, Mode=OneWay}"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="12"
                                               Foreground="#BBFFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="0,0,7,0"
                                               Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Name, Mode=OneWay}"
                                               FontFamily="Segoe UI Variable"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#CCFFFFFF"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               CharacterSpacing="30"
                                               TextTrimming="None"
                                               TextWrapping="NoWrap"/>
                                </Grid>

                                <!-- Entries in this category — one Border wrapping all, Rectangle dividers -->
                                <Border Background="{x:Bind EntryBorderBackground, Mode=OneWay}" BorderBrush="#14FFFFFF" BorderThickness="1"
                                        CornerRadius="10" Margin="16,0,16,8" HorizontalAlignment="Stretch">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{x:Bind Entries, Mode=OneWay}" IsTabStop="False" Padding="0,14,0,14">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ProcessEntry">
                                                    <StackPanel>
                                                        <Rectangle Height="1" Fill="#14FFFFFF"
                                                               Visibility="{x:Bind IsFirstItem, Mode=OneWay, Converter={StaticResource BoolToInverseVisibility}}"/>
                                                        <Grid Padding="6,8,10,6">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- ICON — row 0, col 0: emoji button (hidden when image icon present) -->
                                                            <Button Grid.Row="0" Grid.Column="0"
                                                                Click="IconButton_Click"
                                                                RightTapped="IconButton_RightTapped"
                                                                Style="{StaticResource IconBtn}"
                                                                Foreground="#88FFFFFF" Tag="White"
                                                                IsTabStop="False"
                                                                Width="30" Height="30"
                                                                Margin="0,0,6,0" VerticalAlignment="Center"
                                                                Visibility="{x:Bind HasImageIcon, Mode=OneWay, Converter={StaticResource BoolToInverseVisibility}}"
                                                                ToolTipService.ToolTip="Left-click: emoji picker  •  Right-click: switch to EXE icon">
                                                                <Grid Width="28" Height="28">
                                                                    <TextBlock Text="{x:Bind Icon, Mode=OneWay}" FontSize="18"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Margin="1,2,0,0" Opacity="0.35"/>
                                                                    <TextBlock Text="{x:Bind Icon, Mode=OneWay}" FontSize="18"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                         Fill="#4CAF50"
                                                                         Visibility="{x:Bind IsLaunched, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                                                </Grid>
                                                            </Button>

                                                            <!-- NAME — row 0, col 1 -->
                                                            <StackPanel Grid.Row="0" Grid.Column="1"
                                                                        Orientation="Horizontal" Spacing="7"
                                                                        VerticalAlignment="Center">
                                                                <!-- EXE image icon — shown between name and emoji when extracted -->
                                                                <Button RightTapped="IconButton_RightTapped"
                                                                        Style="{StaticResource IconBtn}"
                                                                        IsTabStop="False"
                                                                        Width="26" Height="26" Padding="0"
                                                                        Visibility="{x:Bind HasImageIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                                        ToolTipService.ToolTip="Right-click: switch to emoji or re-extract EXE icon">
                                                                    <Grid Width="24" Height="24">
                                                                        <Image Width="22" Height="22"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Stretch="Uniform"
                                                                               Visibility="{x:Bind HasImageIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                                               Source="{Binding IconImagePath}"/>
                                                                        <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                                 Fill="#4CAF50"
                                                                                 Visibility="{x:Bind IsLaunched, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                                                    </Grid>
                                                                </Button>
                                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                                           FontSize="14" FontWeight="SemiBold" FontFamily="Bahnschrift"
                                                                           Foreground="#F0FFFFFF" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                <!-- Play -->
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="5"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Button Grid.Row="0" Click="Launch_Click" Style="{StaticResource IconBtn}"
                                                                        Foreground="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource RunningToPlayForegroundConverter}}"
                                                                        Tag="#4CAF50" IsTabStop="True"
                                                                        RightTapped="Play_RightTapped"
                                                                        Opacity="{x:Bind IsLaunched, Mode=OneWay, Converter={StaticResource LaunchedToOpacityConverter}}"
                                                                        ToolTipService.ToolTip="{x:Bind LaunchedPlayTooltip, Mode=OneWay}">
                                                                        <FontIcon Glyph="&#xF5B0;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                                                                    </Button>
                                                                    <Ellipse Grid.Row="1" Width="4" Height="4" Fill="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"
                                                                         Visibility="{x:Bind HasPlayOverride, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                                                </Grid>
                                                                <!-- Stop -->
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="5"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Button Grid.Row="0" Click="Stop_Click" Style="{StaticResource IconBtn}"
                                                                        Foreground="#77FFFFFF" Tag="#F44336" IsTabStop="True"
                                                                        RightTapped="Stop_RightTapped"
                                                                        ToolTipService.ToolTip="{x:Bind StopTooltip, Mode=OneWay}">
                                                                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                                                                    </Button>
                                                                    <Ellipse Grid.Row="1" Width="4" Height="4" Fill="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"
                                                                         Visibility="{x:Bind HasCloseOverride, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                                                </Grid>
                                                                <!-- Focus -->
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="5"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Button Grid.Row="0" Click="Focus_Click" Style="{StaticResource IconBtn}"
                                                                        Foreground="#77FFFFFF" Tag="#4FC3FF" IsTabStop="True"
                                                                        ToolTipService.ToolTip="{x:Bind FocusTooltip, Mode=OneWay}">
                                                                        <FontIcon Glyph="&#xE78B;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                                                                    </Button>
                                                                </Grid>
                                                                <!-- Fullscreen -->
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="5"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Button Grid.Row="0" Click="FocusFullscreen_Click" Style="{StaticResource IconBtn}"
                                                                        Foreground="#77FFFFFF" Tag="#FFC107" IsTabStop="True"
                                                                        RightTapped="Fs_RightTapped"
                                                                        ToolTipService.ToolTip="{x:Bind FsTooltip, Mode=OneWay}">
                                                                        <FontIcon Glyph="&#xE740;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                                                                    </Button>
                                                                    <Ellipse Grid.Row="1" Width="4" Height="4" Fill="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"
                                                                         Visibility="{x:Bind HasFsOverride, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                                                </Grid>
                                                                <!-- More -->
                                                                <Button Click="MoreOptions_Click" Style="{StaticResource IconBtn}"
                                                                    Foreground="#77FFFFFF" Tag="White" IsTabStop="True"
                                                                    ToolTipService.ToolTip="More options">
                                                                    <FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                                                                </Button>
                                                            </StackPanel>

                                                            <!-- PATH — row 1, spans col 0+1, starts under icon -->
                                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                   Text="{x:Bind ShortPath}" FontSize="10" Foreground="#4CFFFFFF"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                                   Margin="0,1,0,0"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Helper text — only shown for Launched category -->
                                        <StackPanel Visibility="{x:Bind IsLaunched, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                Margin="12,4,12,10">
                                            <TextBlock Text="Apps launched via GameTask are pinned here."
                                                   FontSize="10" Foreground="#55FFFFFF" TextWrapping="Wrap"
                                                   FontStyle="Italic" TextAlignment="Center"/>
                                            <TextBlock Text="Press Stop to return to original category."
                                                   FontSize="10" Foreground="#55FFFFFF" TextWrapping="Wrap"
                                                   FontStyle="Italic" TextAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- PANEL OVERLAY — covers entire widget, blocks all input outside open panel -->
        <Grid x:Name="MainOverlay" Grid.Row="0" Grid.RowSpan="3"
              Background="#88000000"
              Visibility="Collapsed"
              IsHitTestVisible="True"
              Canvas.ZIndex="5"/>

        <!-- BOTTOM BAR -->
        <Border Grid.Row="2" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0"
                Background="#1A1A1A" CornerRadius="0,0,8,8" Canvas.ZIndex="10">
            <StackPanel>
                <!-- DEFAULT SETTINGS PANEL -->
                <Border x:Name="DefaultSettingsPanel" Visibility="Collapsed"
                        Background="#1A1A1A" BorderBrush="#28FFFFFF" BorderThickness="0,1,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="370" Padding="12,10,12,6">
                        <StackPanel Spacing="7">

                            <!-- Panel title -->
                            <TextBlock Text="Global Default Behaviors" FontSize="13" Foreground="White"
                                       FontWeight="SemiBold" CharacterSpacing="20" Margin="0,0,0,2"
                                       FontFamily="Segoe UI Variable Display"/>

                            <!-- ── Global defaults group (dims when per-cat is on) ── -->
                            <StackPanel x:Name="GlobalDefaultsGroup" Spacing="5">
                                <StackPanel Spacing="2" Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE909;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                  Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="MasterDefaultsLabel"
                                                   Text="Global"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Applies to all apps without a manual or category override."
                                               FontSize="9" Foreground="#55FFFFFF" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Play behaviour: icon+label on same row as dropdown -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5"
                                                VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="108">
                                        <FontIcon Glyph="&#xF5B0;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                                  Foreground="#66FFFFFF" VerticalAlignment="Center"/>
                                        <TextBlock Text="Play behaviour" FontSize="10" Foreground="#66FFFFFF"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ComboBox x:Name="DefaultPlayCombo" Grid.Column="1"
                                              Style="{StaticResource DarkComboBox}">
                                        <ComboBoxItem Content="Stay on Game Bar"/>
                                        <ComboBoxItem Content="Close Game Bar"/>
                                        <ComboBoxItem Content="Focus launched app"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Close behaviour: icon+label on same row as dropdown -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5"
                                                VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="108">
                                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                                  Foreground="#66FFFFFF" VerticalAlignment="Center"/>
                                        <TextBlock Text="Close behaviour" FontSize="10" Foreground="#66FFFFFF"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ComboBox x:Name="DefaultCloseCombo" Grid.Column="1"
                                              Style="{StaticResource DarkComboBox}">
                                        <ComboBoxItem Content="Stay on Game Bar"/>
                                        <ComboBoxItem Content="Close Game Bar"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Fullscreen mode: icon+label on same row as dropdown -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5"
                                                VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="108">
                                        <FontIcon Glyph="&#xE740;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                                  Foreground="#66FFFFFF" VerticalAlignment="Center"/>
                                        <TextBlock Text="Fullscreen mode" FontSize="10" Foreground="#66FFFFFF"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ComboBox x:Name="DefaultFsCombo" Grid.Column="1"
                                              Style="{StaticResource DarkComboBox}">
                                        <ComboBoxItem Content="Maximize window"/>
                                        <ComboBoxItem Content="Key only"/>
                                        <ComboBoxItem Content="Focus → Key"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <!-- Divider before per-category section -->
                            <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,4,0,0"/>

                            <!-- ── Per-Category Defaults toggle (below global defaults) ── -->
                            <Grid HorizontalAlignment="Stretch" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center"
                                            Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE8EC;" FontFamily="Segoe Fluent Icons"
                                                  FontSize="15" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                        <TextBlock Text="Per-Category Defaults" FontSize="10"
                                                   Foreground="#99FFFFFF" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Per-Category overrides Global defaults"
                                               FontSize="9" Foreground="#55FFFFFF" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="PerCatDefaultsToggle"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              MinWidth="0" Margin="0" Padding="0"
                                              OnContent="" OffContent=""
                                              Toggled="PerCatDefaultsToggle_Toggled"/>
                            </Grid>

                            <!-- Per-category expanded rows (built in code-behind) -->
                            <StackPanel x:Name="CatDefaultsSection"
                                        Visibility="Collapsed"
                                        Margin="0,4,0,4"/>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ADD SECTION -->
                <Border x:Name="AddSection"
                        Background="#1A1A1A" BorderBrush="#28FFFFFF" BorderThickness="0,1,0,0"
                        Padding="12,10" Visibility="Collapsed">
                    <StackPanel Spacing="7">
                        <TextBlock Text="Add app" FontSize="13" Foreground="White" FontWeight="SemiBold" CharacterSpacing="20" FontFamily="Segoe UI Variable Display" Margin="0,0,0,2"/>

                        <!-- REQUIRED FIELDS -->
                        <TextBlock Text="Required" FontSize="10" Foreground="#55FFFFFF"
                                   FontWeight="SemiBold" CharacterSpacing="60" Margin="0,2,0,-2"/>
                        <TextBox x:Name="ExePathBox" PlaceholderText="C:\path\to\launch.exe"
                                 Style="{StaticResource DarkTextBoxWithIcon}" Tag="&#xF5B0;"
                                 TextChanged="ExePathBox_TextChanged"/>
                        <TextBox x:Name="AppNameBox" PlaceholderText="App name (required)"
                                 Style="{StaticResource DarkTextBoxWithIcon}" Tag="&#xE70F;"
                                 TextChanged="AppNameBox_TextChanged"/>
                        <ComboBox x:Name="CategoryCombo"
                                  Style="{StaticResource DarkComboBoxWithIcon}"
                                  Tag="&#xE8EC;"
                                  PlaceholderText="Category"
                                  SelectionChanged="CategoryCombo_SelectionChanged"/>

                        <!-- OPTIONAL FIELDS TOGGLE -->
                        <Button x:Name="ToggleOptionalButton" Click="ToggleOptional_Click"
                                HorizontalAlignment="Left" Background="Transparent"
                                BorderThickness="0" Padding="0" Height="24">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon x:Name="OptionalChevron" Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="#66FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock Text="Optional" FontSize="10" Foreground="#66FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- OPTIONAL FIELDS PANEL -->
                        <Border x:Name="OptionalFieldsPanel" Visibility="Collapsed">
                            <StackPanel Spacing="7">
                                <TextBox x:Name="CloseExePathBox"
                                         PlaceholderText="C:\path\to\stop.exe"
                                         Style="{StaticResource DarkTextBoxWithIcon}" Tag="&#xE711;"
                                         ToolTipService.ToolTip="Use this when the process to kill is different from the one launched (e.g. a launcher that spawns a child process)"/>
                                <TextBox x:Name="FocusExePathBox"
                                         PlaceholderText="C:\path\to\focus.exe"
                                         Style="{StaticResource DarkTextBoxWithIcon}" Tag="&#xE78B;"
                                         ToolTipService.ToolTip="Use this when the window to bring to foreground is different from the launched process (e.g. a game launched via a launcher)"/>
                                <!-- Arguments preset picker -->
                                <ComboBox x:Name="ArgsCombo"
                                          PlaceholderText="Argument presets"
                                          Style="{StaticResource DarkComboBoxWithIcon}"
                                          Tag="&#xE943;"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="ArgsCombo_SelectionChanged">

                                    <!-- ── Window mode ─────────────────────────────────────── -->
                                    <ComboBoxItem IsEnabled="False" Padding="8,5,8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE78B;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#55FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="Window mode" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#55FFFFFF" VerticalAlignment="Center" CharacterSpacing="40"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-fullscreen">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE78B;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-fullscreen (force exclusive fullscreen)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-windowed">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE78B;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-windowed (run in a window)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-borderless">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE78B;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-borderless (borderless windowed)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-noborder">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE78B;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-noborder (borderless windowed, Source engine)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <!-- ── Graphics API ────────────────────────────────────── -->
                                    <ComboBoxItem IsEnabled="False" Padding="8,5,8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#55FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="Graphics API" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#55FFFFFF" VerticalAlignment="Center" CharacterSpacing="40"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-dx11">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-dx11 (force DirectX 11)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-dx12">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-dx12 (force DirectX 12)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-vulkan">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-vulkan (force Vulkan renderer)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-opengl">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-opengl (force OpenGL renderer)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <!-- ── Startup ─────────────────────────────────────────── -->
                                    <ComboBoxItem IsEnabled="False" Padding="8,5,8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xF5B0;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#55FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="Startup" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#55FFFFFF" VerticalAlignment="Center" CharacterSpacing="40"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-nosplash">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xF5B0;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-nosplash (skip splash screen)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-nointro">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xF5B0;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-nointro (skip intro cinematics)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-novid">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xF5B0;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-novid (skip startup video, Source engine)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-console">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xF5B0;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-console (enable developer console)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-safe">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xF5B0;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-safe (launch in safe / low settings mode)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <!-- ── Performance ────────────────────────────────────── -->
                                    <ComboBoxItem IsEnabled="False" Padding="8,5,8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#55FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="Performance" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#55FFFFFF" VerticalAlignment="Center" CharacterSpacing="40"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-high">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-high (set process priority to High)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="-threads 8">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="-threads 8 (manually set CPU thread count)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <!-- ── Custom ─────────────────────────────────────────── -->
                                    <ComboBoxItem Tag="__custom__">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                      Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="Custom…" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                                <!-- Always-visible args box — preset picker appends to this; user can edit freely -->
                                <TextBox x:Name="ArgsBox"
                                         PlaceholderText="-you -can -stack -multiple -commands"
                                         Style="{StaticResource DarkTextBoxWithIcon}" Tag="&#xE943;"/>
                            </StackPanel>
                        </Border>

                        <Button Content="+ Add to list" Click="Add_Click"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AddBtn}"/>
                    </StackPanel>
                </Border>

                <!-- INFO PANEL -->
                <Border x:Name="InfoPanel" Visibility="Collapsed"
                        Background="#1A1A1A" BorderBrush="#28FFFFFF" BorderThickness="0,1,0,0" Padding="12,10">
                    <StackPanel Spacing="7">
                        <TextBlock Text="App info" FontSize="11" Foreground="#99FFFFFF" FontWeight="SemiBold" CharacterSpacing="60" Margin="0,0,0,2" FontFamily="Segoe UI Variable"/>

                        <!-- Description label + multiline box -->
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#66FFFFFF"/>
                            <TextBlock Text="Description" FontSize="10" Foreground="#66FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox x:Name="InfoDescriptionBox"
                                 PlaceholderText="Short description of this app…"
                                 Style="{StaticResource DarkTextBoxMultiLine}"/>

                        <!-- Website URL -->
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#66FFFFFF"/>
                            <TextBlock Text="Website URL" FontSize="10" Foreground="#66FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox x:Name="InfoUrlBox"
                                 PlaceholderText="https://example.com"
                                 Style="{StaticResource DarkTextBoxWithIcon}" Tag="&#xE71B;"/>

                        <!-- Update URL -->
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#66FFFFFF"/>
                            <TextBlock Text="Update URL" FontSize="10" Foreground="#66FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox x:Name="InfoUpdateUrlBox"
                                 PlaceholderText="https://example.com/releases"
                                 Style="{StaticResource DarkTextBoxWithIcon}" Tag="&#xE895;"/>

                        <!-- Action buttons row -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="InfoOpenWebsiteButton" Grid.Column="0"
                                    Content="Open Website"
                                    Click="InfoOpenWebsite_Click"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AddBtn}"/>
                            <Button x:Name="InfoCheckUpdatesButton" Grid.Column="2"
                                    Content="Check for Updates"
                                    Click="InfoCheckUpdates_Click"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AddBtn}"/>
                        </Grid>

                        <Button Content="Save" Click="InfoSave_Click"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AddBtn}"/>
                    </StackPanel>
                </Border>

                <!-- REORDER CATEGORIES PANEL -->
                <Border x:Name="ReorderPanel" Visibility="Collapsed"
                        Background="#1A1A1A" BorderBrush="#28FFFFFF" BorderThickness="0,1,0,0" Padding="12,10">
                    <StackPanel Spacing="4">

                        <!-- Row 1: title -->
                        <TextBlock Text="Category settings" FontSize="13" Foreground="White" FontWeight="SemiBold" CharacterSpacing="20" FontFamily="Segoe UI Variable Display"/>

                        <!-- Row 2: pin icon+label on left, toggle on far right -->
                        <Grid HorizontalAlignment="Stretch" Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE840;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock Text="Pin launched apps" FontSize="10" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="PinLaunchToggle"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          MinWidth="0" Margin="0" Padding="0"
                                          OnContent="" OffContent=""/>
                        </Grid>

                        <StackPanel x:Name="ReorderList" Spacing="2"/>
                    </StackPanel>
                </Border>

                <!-- HELPER ERROR PANEL -->
                <Border x:Name="HelperErrorPanel" Visibility="Collapsed"
                        Background="#3D1A1A" BorderBrush="#6B2020" BorderThickness="0,1,0,0" Padding="12,10">
                    <StackPanel Spacing="6">
                        <!-- Header row -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE814;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                      Foreground="#F44336" VerticalAlignment="Center"/>
                            <TextBlock Text="Background service not running" FontSize="11" FontWeight="SemiBold" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Body -->
                        <TextBlock FontSize="10" Foreground="#99FFFFFF" TextWrapping="Wrap"
                                   Text="Without it, the widget loses focus after every click — buttons won't work as expected. Run Launcher.exe manually from its install folder, then check Task Manager to confirm it's active."/>
                        <!-- Path hint — always shown; updated from code-behind when path is known -->
                        <TextBlock x:Name="HelperPathHint" FontSize="10" Foreground="#66FFFFFF" TextWrapping="Wrap"
                                   Text="Run manually: Launcher.exe — check its install folder"/>
                    </StackPanel>
                </Border>

                <!-- PINNED SAVE BUTTON — visible only when DefaultSettingsPanel is open -->
                <Border x:Name="SaveButtonRow" Visibility="Collapsed"
                        Background="#1A1A1A" BorderBrush="#28FFFFFF" BorderThickness="0,1,0,0"
                        Padding="12,6,12,6">
                    <Button x:Name="GlobalSaveButton" Content="Save"
                            Click="DefaultSettingsSave_Click"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AddBtn}"/>
                </Border>

                <!-- TOOLBAR -->
                <Grid Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="ToggleInfoButton" Click="ToggleInfo_Click"
                                Style="{StaticResource IconBtn}"
                                Foreground="#80FFFFFF" Tag="White"
                                IsTabStop="True" UseSystemFocusVisuals="True"
                                ToolTipService.ToolTip="App Info"
                                Width="30" Height="30">
                            <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                        </Button>
                        <Button x:Name="LauncherRefreshButton" Click="LauncherRefresh_Click"
                                Visibility="Collapsed"
                                Style="{StaticResource IconBtn}"
                                Foreground="#F44336" Tag="#F44336"
                                ToolTipService.ToolTip="Missing process — click to view"
                                Width="30" Height="30">
                            <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="ReorderCategoriesButton" Click="ReorderCategories_Click"
                                Style="{StaticResource IconBtn}"
                                Foreground="#80FFFFFF" Tag="White"
                                IsTabStop="True" UseSystemFocusVisuals="True"
                                ToolTipService.ToolTip="Categories"
                                Width="30" Height="30">
                            <FontIcon Glyph="&#xE8EC;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                        </Button>
                        <Button x:Name="DefaultSettingsButton" Click="ToggleDefaultSettings_Click"
                                Style="{StaticResource IconBtn}"
                                Foreground="#80FFFFFF" Tag="White"
                                IsTabStop="True" UseSystemFocusVisuals="True"
                                ToolTipService.ToolTip="Default Behaviours"
                                Width="30" Height="30">
                            <FontIcon Glyph="&#xE90F;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                        </Button>
                        <Button x:Name="ToggleAddButton" Click="ToggleAdd_Click"
                                Style="{StaticResource IconBtn}"
                                Foreground="#80FFFFFF" Tag="White"
                                IsTabStop="True" UseSystemFocusVisuals="True"
                                ToolTipService.ToolTip="Add app"
                                Width="30" Height="30">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
